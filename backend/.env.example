# 复制为 .env 后按需改。真实凭据不入库。
# 本地 Postgres 默认来自 docker-compose.yml
DATABASE_URL=postgresql+asyncpg://clear_complaint:clear_complaint@localhost:5432/clear_complaint

# AgentArts 工作流运行时（后端调用）。KEY 经私密渠道交付，值不入库。
AGENTARTS_PROFILE_INTAKE_URL=https://defaultgw-mqytamjqmn.cn-southwest-2.huaweicloud-agentarts.com/runtimes/agent-arts-b86c2f610cf64a89b8e215050e9e4508/invocations
AGENTARTS_PROFILE_INTAKE_API_KEY=
AGENTARTS_FOLLOWUP_SUPPLEMENT_URL=https://defaultgw-mqytamjqmn.cn-southwest-2.huaweicloud-agentarts.com/runtimes/agent-arts-6a31c4e6059f4696ab5d0f458220c7bf/invocations
AGENTARTS_FOLLOWUP_SUPPLEMENT_API_KEY=
AGENTARTS_TRIAGE_URL=https://defaultgw-mqytamjqmn.cn-southwest-2.huaweicloud-agentarts.com/runtimes/agent-arts-5f50106a25aa496abf99dfd7c362e5c6/invocations
AGENTARTS_TRIAGE_API_KEY=
AGENTARTS_INVOKE_MODE=published

# 进程内定时任务（用药提醒生成、超时、过期、未保存清理）。测试与 CI 保持关闭
SCHEDULER_ENABLED=true

# 导出包落盘目录（24 小时有效、一次性下载）
EXPORT_DIR=/tmp/clear-complaint-exports

# 认证密钥。生产必须注入强随机值；本地与 CI 留空则用代码里的开发默认值
# JWT_SECRET=

# 隐私政策链接（GET /api/meta/privacy 返回给前端），默认使用已交付的站内说明页。
# 可覆盖为部署地址；显式设为空串时前端应隐藏对应入口
# PRIVACY_POLICY_URL=
# SENSITIVE_POLICY_URL=
